{
  "name": "chrome-extension-todo",
  "version": "1.0.0",
  "type": "module",
  "description": "ZenTodo is a high-end Chrome extension that replaces your New Tab page with a minimalist, focused, and aesthetically pleasing To-Do list environment.",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build": "vite build",
    "count-lines": "node scripts/countLines.js",
    "generate:tree": "node scripts/automated_project_tree.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "benchmark": "node scripts/benchmark.mjs",
    "desktop:build": "npm run build && cd electron/desktop && npm install && node build.js",
    "desktop:start": "cd electron/desktop && npm install && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halilogia/chrome-extension-todo.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.1.40",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsc-alias": "^1.9.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "katex": "^0.18.0",
    "preact": "^10.29.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  }
}
