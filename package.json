{
  "name": "life-os",
  "version": "1.0.0",
  "type": "module",
  "description": "LifeOS is an intelligent, privacy-first personal dashboard and autonomous assistant Chrome extension with Clean Architecture.",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "node scripts/ensureFixtures.mjs && vite",
    "build": "node scripts/ensureFixtures.mjs && vite build",
    "typecheck": "node scripts/ensureFixtures.mjs && tsc --noEmit",
    "count-lines": "node scripts/countLines.js",
    "generate:tree": "node scripts/automated_project_tree.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run lint -- --quiet && npm run test && npm run build && node scripts/runAnalyzers.mjs && node scripts/findDeadFiles.mjs && node scripts/i18nHealthCheck.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halilogia/LifeOS.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.1.40",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsc-alias": "^1.9.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "katex": "^0.18.0",
    "preact": "^10.29.7",
    "topojson-client": "^3.1.0",
    "unpdf": "^1.8.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  }
}
