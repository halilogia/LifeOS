{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "outDir": ".",
    "rootDir": ".",
    "types": ["chrome"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
