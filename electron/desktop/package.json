{
  "name": "mindvault-desktop",
  "version": "1.0.0",
  "description": "MindVault Desktop — KPSS Not Alma Stüdyosu (Chrome eklentisinin masaüstü sarmalayıcısı)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mindvault.desktop",
    "productName": "MindVault",
    "files": ["main.js", "preload.js", "icon.png", "web/**/*"],
    "win": {
      "target": ["portable"],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "MindVault.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
