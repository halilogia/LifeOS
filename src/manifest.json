{
  "manifest_version": 3,
  "name": "Life OS - Personal Dashboard",
  "version": "1.0.0",
  "description": "Kişisel yaşam yönetimi, KPSS takibi, Pomodoro, Namaz vakitleri ve Hıfız özellikli tamamen kişiselleştirilmiş bir New Tab arayüzü.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "notifications", "tabs", "alarms", "identity", "sidePanel", "tabGroups", "contextMenus", "tabCapture", "offscreen", "scripting"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://www.gamerpower.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://halkarz.com/*",
    "https://www.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "oauth2": {
    "client_id": "1061579928611-pgijn1nbhseg9pvkf72ooo6j8re44flb.apps.googleusercontent.com",
    "scopes": [
      "email",
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Life OS - Personal Dashboard"
  },
  "commands": {
    "open_companion_ai": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Life OS Web Copilot / Companion AI Yan Panelini Aç"
    },
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Life OS Web Copilot Yan Panelini Aç/Kapat"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
